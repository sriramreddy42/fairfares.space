RESEND_API_KEY=replace_with_new_resend_key
RESEND_FROM=FairFares <onboarding@resend.dev>

# Local default is data/fairfares.sqlite3. In production, point this to persistent storage.
# FAIRFARES_DB_PATH=/var/data/fairfares.sqlite3

# Optional fallback SMTP settings.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASSWORD=password
# SMTP_FROM=hello@fairfares.com
