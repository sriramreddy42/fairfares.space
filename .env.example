RESEND_API_KEY=replace_with_new_resend_key
RESEND_FROM=FairFares <onboarding@resend.dev>

# Stripe Checkout for booking holds.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Required for the first administrator bootstrap. Use deployment secrets, never
# commit real values. Remove FAIRFARES_ADMIN_PASSWORD after the account exists.
# FAIRFARES_ADMIN_EMAIL=owner@example.com
# FAIRFARES_ADMIN_PASSWORD=use-a-long-random-password
# FAIRFARES_APP_SECRET=use-at-least-32-random-characters
# FAIRFARES_TRUST_PROXY=1

# Optional Slack operations alerts. SLACK_BOT_TOKEN is preferred; webhooks are fallback only.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_BOOKINGS=#bookings
# SLACK_CHANNEL_PAYMENTS=#payments
# SLACK_CHANNEL_PICKUPS=#pickups
# SLACK_CHANNEL_RETURNS=#returns
# SLACK_CHANNEL_SUPPORT=#customer-support
# SLACK_CHANNEL_VEHICLES=#vehicle-maintenance
# SLACK_CHANNEL_ADMIN=#admin
# SLACK_CHANNEL_AI=#ai-agent
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_BOOKINGS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_PICKUPS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_SUPPORT=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_VEHICLES=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_PAYMENTS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_ADMIN=https://hooks.slack.com/services/...

# Local default is data/fairfares.sqlite3. In production, point this to persistent storage.
# FAIRFARES_DB_PATH=/var/data/fairfares.sqlite3
# FAIRFARES_BACKUP_DIR=/var/data/backups
# FAIRFARES_BACKUP_KEEP=20
# FAIRFARES_AUTO_BACKUP=1

# Optional fallback SMTP settings.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASSWORD=password
# SMTP_FROM=hello@fairfares.com
