RESEND_API_KEY=replace_with_new_resend_key
RESEND_FROM=FairFares <onboarding@resend.dev>

# Stripe Checkout for booking holds.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Required for the first administrator bootstrap. Use deployment secrets, never
# commit real values. Remove FAIRFARES_ADMIN_PASSWORD after the account exists.
# FAIRFARES_ADMIN_EMAIL=owner@example.com
# FAIRFARES_ADMIN_PASSWORD=use-a-long-random-password
# FAIRFARES_APP_SECRET=use-at-least-32-random-characters
# FAIRFARES_TRUST_PROXY=1

# Native social sign-in. Create separate Google OAuth clients for iOS,
# Android, and web, then allow every client ID that can issue a mobile token.
# GOOGLE_OAUTH_CLIENT_IDS=ios-client.apps.googleusercontent.com,android-client.apps.googleusercontent.com,web-client.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=ios-client.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=android-client.apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_ID=web-client.apps.googleusercontent.com
# Apple Sign in with Apple audience. The native app uses its bundle ID.
# Accepts a comma-separated list. FairFares always permits its owned native IDs
# com.fairfares.mobile and com.fairfares.app; list any additional Apple Services ID here.
# APPLE_SIGN_IN_CLIENT_IDS=com.fairfares.mobile,com.fairfares.app

# Required to verify a phone number before completing a new social sign-in.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
# TWILIO_VERIFY_SERVICE_SID=VA...

# Optional Slack operations alerts. SLACK_BOT_TOKEN is preferred; webhooks are fallback only.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_BOOKINGS=#bookings
# SLACK_CHANNEL_PAYMENTS=#payments
# SLACK_CHANNEL_PICKUPS=#pickups
# SLACK_CHANNEL_RETURNS=#returns
# SLACK_CHANNEL_SUPPORT=#customer-support
# SLACK_CHANNEL_VEHICLES=#vehicle-maintenance
# SLACK_CHANNEL_ADMIN=#admin
# SLACK_CHANNEL_ALERTS=#alerts
# SLACK_CHANNEL_AI=#ai-agent
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_BOOKINGS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_PICKUPS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_SUPPORT=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_VEHICLES=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_PAYMENTS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_ADMIN=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_ALERTS=https://hooks.slack.com/services/...
# Duplicate operational alerts are suppressed for this many seconds.
# FAIRFARES_ALERT_THROTTLE_SECONDS=300
# Requests at or above this duration trigger a warning.
# FAIRFARES_SLOW_REQUEST_MS=5000

# Local default is data/fairfares.sqlite3. In production, point this to persistent storage.
# FAIRFARES_DB_PATH=/var/data/fairfares.sqlite3
# FAIRFARES_BACKUP_DIR=/var/data/backups
# FAIRFARES_BACKUP_KEEP=20
# FAIRFARES_AUTO_BACKUP=1
# Expired member housing listings remain recoverable for this many days before
# their row, interest records, and listing images are permanently deleted.
# FAIRFARES_HOUSING_RECOVERY_DAYS=7

# Private Cloudflare R2 storage for Chitthi attachments. Create a bucket-scoped
# Object Read & Write token for fairfares-attachments. Never expose these values
# to the mobile app or commit real credentials.
# CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# CLOUDFLARE_R2_BUCKET=fairfares-attachments
# CLOUDFLARE_R2_PREFIX=fairfares
# Optional override; normally derived from the account ID.
# CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Optional fallback SMTP settings.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASSWORD=password
# SMTP_FROM=hello@fairfares.com
