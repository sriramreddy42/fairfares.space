+  // Resolves the key window in a scene-aware way. UIApplication.shared.keyWindow is
+  // deprecated and can be nil on newer iOS / multi-window setups, which previously caused
+  // a fatalError crash that made "Sign in with Apple" appear to do nothing.
+  private static func resolvePresentationWindow() -> UIWindow? {
+    return UIApplication.shared.connectedScenes
+      .compactMap { $0 as? UIWindowScene }
+      .first(where: { $0.activationState == .foregroundActive })
+      .flatMap { $0.windows.first(where: { $0.isKeyWindow }) ?? $0.windows.first }
+      ?? UIApplication.shared.keyWindow
+  }
