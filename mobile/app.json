{
  "expo": {
    "name": "FairFares",
    "slug": "fairfares-mobile",
    "newArchEnabled": true,
    "scheme": "fairfares",
    "version": "0.1.5",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "usesAppleSignIn": true,
      "appleTeamId": "9RVTF77D2S",
      "buildNumber": "13",
      "bundleIdentifier": "com.fairfares.mobile",
      "icon": "./assets/app-icon.png",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:fairfare.space",
        "applinks:www.fairfare.space"
      ],
      "entitlements": {
        "com.apple.developer.siri": true,
        "com.apple.developer.usernotifications.communication": true,
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.fairfares.mobile",
          "$(AppIdentifierPrefix)com.fairfares.mobile.shared"
        ]
      },
      "infoPlist": {
        "NSUserActivityTypes": [
          "INSendMessageIntent"
        ],
        "NSLocationWhenInUseUsageDescription": "FairFares uses your location to set ride pickup, find nearby drivers, and estimate distance.",
        "NSCameraUsageDescription": "Allow FairFares to take a photo that you choose to send in Chitthi.",
        "NSPhotoLibraryUsageDescription": "Allow FairFares to select photos and videos that you choose to send in Chitthi.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fairfares.mobile",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#101010"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fairfare.space",
              "pathPrefix": "/chitthi/"
            },
            {
              "scheme": "https",
              "host": "www.fairfare.space",
              "pathPrefix": "/chitthi/"
            },
            {
              "scheme": "https",
              "host": "fairfare.space",
              "pathPrefix": "/fchat/"
            },
            {
              "scheme": "https",
              "host": "www.fairfare.space",
              "pathPrefix": "/fchat/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FairFares to share your live location only when you explicitly start location sharing in Chitthi."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F6BFF",
          "defaultChannel": "chitthi-messages-v2"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FairFares to select photos and videos that you choose to send in Chitthi.",
          "cameraPermission": "Allow FairFares to take a photo that you choose to send in Chitthi.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow FairFares to privately find contacts who chose to be discoverable and let you select a contact to share in Chitthi. Your address book is not uploaded."
        }
      ],
      "@bacons/apple-targets",
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "apiUrl": "https://www.fairfare.space",
      "eas": {
        "projectId": "e5c86839-49a9-4c8f-9477-37c971df2344",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.fairfares.mobile.fchat-notification-service",
                  "targetName": "FChatNotificationService"
                }
              ]
            }
          }
        }
      }
    }
  }
}
