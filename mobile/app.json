{
  "expo": {
    "name": "FairFares",
    "slug": "fairfares-mobile",
    "scheme": "fairfares",
    "version": "0.1.1",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.fairfares.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FairFares uses your location to set ride pickup, find nearby drivers, and estimate distance."
      }
    },
    "android": {
      "package": "com.fairfares.mobile",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#101010"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow FairFares to privately find contacts who chose to be discoverable. Contact names and your address book are not uploaded."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://fairfares.onrender.com",
      "eas": {
        "projectId": "e5c86839-49a9-4c8f-9477-37c971df2344"
      }
    }
  }
}
