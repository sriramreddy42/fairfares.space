{
  "appId": "com.fairfares.app",
  "appName": "FairFares",
  "webDir": "static",
  "server": {
    "url": "https://www.fairfare.space",
    "cleartext": false,
    "allowNavigation": [
      "www.fairfare.space",
      "fairfare.space",
      "www.google.com",
      "maps.google.com",
      "*.google.com",
      "*.googleapis.com",
      "*.gstatic.com"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "FairFares"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  }
}
